{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/timecraft-studio.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "always",
      "features": {
        "handTracking": true
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "fov": 44,
      "near": 0.001,
      "far": 200,
      "camera": {
        "position": [
          0.30,
          1.73,
          0.13
        ],
        "lookAt": [0.02, 1.26, -0.62]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": { "useHandPinchForGrab": true },
      "physics": false,
      "sceneUnderstanding": false,
      "environmentRaycast": false,
      "spatialUI": {
        "kit": "horizon"
      }
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "environment": "living_room"
    }
  }
}
